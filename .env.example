# Copiez ce fichier en « .env » puis adaptez les valeurs.
# Le fichier .env ne doit JAMAIS être publié sur GitHub.

# Clé de signature des sessions : générez-en une avec
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-cle-avant-la-mise-en-ligne

# Compte du back-office créé au premier démarrage
ADMIN_EMAIL=dialawactu2020@gmail.com
ADMIN_MOT_DE_PASSE=thiouk094@

# Nom du fichier de base de données
DATABASE_NAME=dialaw_live.db

# Mettez « production » une fois le site en ligne (active les cookies HTTPS)
FLASK_ENV=development

# Port d'écoute (Render/Heroku le fournissent automatiquement)
PORT=5000
